# Copiare in `.env` e riempire. Il file `.env` non va mai committato.
#
# Questo file elenca **solo** le variabili che il backend Java legge davvero
# (`server-java/src/main/resources/application.properties`) e quelle che
# `docker-compose.yml` interpola. Non ci sono valori veri: i segnaposto vanno
# sostituiti, non lasciati come sono.
#
# In Docker `.env` viene caricato due volte, e la cosa e' voluta: una come
# `env_file` del servizio `backend` (le variabili finiscono dentro il container)
# e una da `docker compose` stesso, che lo legge per risolvere le scritture
# `${...}` nel compose file.

# ─── Obbligatorie ───────────────────────────────────────────────────────────────

# Segreto di firma dei JWT. Generalo con:  openssl rand -base64 64
# Il backend si rifiuta di partire se manca o se e' piu' corto di 32 caratteri
# (JwtService): prima c'era un fallback nel codice, e senza questa variabile
# l'app firmava i token con una stringa scritta nel sorgente.
JWT_SECRET=

# Password del database Postgres. Usata sia da `db` (POSTGRES_PASSWORD) sia dal
# backend (DB_PASSWORD) in docker-compose.yml, che non ha piu' un default: prima
# era "password" in chiaro nel file, uguale su ogni checkout del repo.
# Generala con:  openssl rand -base64 32
DB_PASSWORD=

# ─── Primo amministratore ───────────────────────────────────────────────────────
# Se le riempi, all'avvio il backend crea questo account amministratore (e se
# l'indirizzo esiste gia' si limita a promuoverlo, senza toccarne la password).
# Serve su un'installazione nuova: l'unico admin del seed di scuola ha una
# password che nessuno conosce, e senza questo bisognerebbe scrivere un hash
# BCrypt a mano dentro Postgres. Minimo 8 caratteri.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Amministratore

# ─── Database ───────────────────────────────────────────────────────────────────
# In Docker questi valori arrivano gia' da docker-compose.yml. Servono solo per
# far girare il backend fuori dai container, e sono in formato **JDBC**: il
# backend e' Spring Boot, non legge l'URL stile `postgresql://utente:password@...`
# che usava Prisma. La password resta fuori dall'URL, in DB_PASSWORD.
DATABASE_URL_JDBC=jdbc:postgresql://localhost:5433/mydb
DB_USER=user

# ─── URL ────────────────────────────────────────────────────────────────────────
# FRONTEND_URL e' anche l'**unica** origine ammessa da CORS (SecurityConfig) e la
# base dei link dentro le email: sbagliarlo rompe entrambe le cose.
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:3000

# Porta su cui ascolta il backend. In Docker la impone il compose (3000, la
# stessa che il frontend si aspetta); fuori, senza questa riga, e' 8080.
PORT=3000

# ─── Sessione ───────────────────────────────────────────────────────────────────
# Durata del cookie di sessione, in giorni.
JWT_TTL_DAYS=7

# Flag Secure sul cookie di sessione. Va acceso **insieme** a HTTPS: acceso
# adesso, che il progetto gira in HTTP, il browser smette di mandare il cookie e
# il login non funziona piu' su nessun host che non sia localhost.
COOKIE_SECURE=false

# ─── File caricati ──────────────────────────────────────────────────────────────
# Cartella delle foto prodotto caricate dagli admin, relativa alla directory di
# lavoro del processo. In Docker e' un volume nominato e non va cambiata.
UPLOADS_DIR=uploads

# ─── Email ──────────────────────────────────────────────────────────────────────
# Quale trasporto usare: "smtp" oppure vuoto. Vuoto = niente invio, le email
# vengono solo scritte nei log (che e' lo stato giusto in sviluppo).
# Resend non c'e' piu': era il trasporto del backend Node dismesso, e il backend
# Java non ha nessun codice che lo usi. Se nel tuo `.env` sono rimaste
# RESEND_API_KEY o RESEND_SENDER_*, non le legge nessuno.
MAIL_PROVIDER=

# Mittente. Con SMTP deve coincidere con la mailbox autenticata, altrimenti il
# server rifiuta il messaggio o finisce dritto nello spam.
MAIL_FROM=noreply@example.it

# SMTP. Usati solo con MAIL_PROVIDER=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# ─── Pagamenti (Stripe) ───────────────────────────────────────────────────────
# Vuote: il checkout resta simulato, nessun addebito reale, e l'applicazione
# parte lo stesso. Chiavi di test su https://dashboard.stripe.com/test/apikeys
# Il fornitore vero entra in gioco solo quando ci sono **sia** la chiave segreta
# **sia** il segreto del webhook (StripeProperties#enabled).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Firma del webhook. In locale la stampa `stripe listen --forward-to \
# localhost:3000/api/payments/webhook`. Senza, il webhook rifiuta tutto.
STRIPE_WEBHOOK_SECRET=
