# Copiare in `.env` e riempire. Il file `.env` non va mai committato.

# ─── Obbligatorie ───────────────────────────────────────────────────────────────

# Segreto di firma dei JWT. Generalo con:  openssl rand -base64 64
# Il backend si rifiuta di partire se manca o se e' piu' corto di 32 caratteri: prima
# c'era un fallback nel codice, e senza questa variabile l'app firmava i token con una
# stringa scritta nel sorgente.
JWT_SECRET=

# Password del database Postgres. Usata sia da `db` (POSTGRES_PASSWORD) sia dal
# backend (DB_PASSWORD/DATABASE_URL_JDBC) in docker-compose.yml, che non ha piu' un
# default: prima era "password" in chiaro nel file, uguale su ogni checkout del repo.
# Generala con:  openssl rand -base64 32
DB_PASSWORD=

# ─── Primo amministratore ───────────────────────────────────────────────────────
# Se le riempi, all'avvio il backend crea questo account amministratore (e se
# l'indirizzo esiste gia' si limita a promuoverlo, senza toccarne la password).
# Serve su un'installazione nuova: l'unico admin del seed di scuola ha una
# password che nessuno conosce, e senza questo bisognerebbe scrivere un hash
# BCrypt a mano dentro Postgres. Minimo 8 caratteri.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Amministratore

# ─── Database ───────────────────────────────────────────────────────────────────
# In Docker questi valori arrivano gia' da docker-compose.yml; servono se si fa girare
# il backend fuori dai container.
DATABASE_URL=postgresql://user:password@localhost:5433/mydb

# ─── URL ────────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:3000

# Origin extra ammessi da CORS, separati da virgola. Serve per gli ambienti effimeri
# (Codespaces, Gitpod) quando NODE_ENV e' production: fuori da produzione i domini
# *.app.github.dev e *.gitpod.io sono gia' accettati.
CORS_EXTRA_ORIGINS=

# ─── Ambiente ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Numero di proxy di cui fidarsi per leggere X-Forwarded-For (es. 1 se davanti c'e' un
# nginx). Lasciare vuoto se il backend viene raggiunto direttamente: dichiarare un proxy
# che non esiste rende di nuovo falsificabile l'IP del client.
TRUST_PROXY=

# ─── Email ──────────────────────────────────────────────────────────────────────
# Quale trasporto usare: "smtp" oppure "resend". Vuoto = niente invio, le email
# vengono solo scritte nei log (che e' lo stato giusto in sviluppo).
MAIL_PROVIDER=smtp

# Mittente. Con SMTP deve coincidere con la mailbox autenticata, altrimenti il
# server rifiuta il messaggio o finisce dritto nello spam.
MAIL_FROM=noreply@example.it

# SMTP. STARTTLS (587) e SSL implicito (465) si escludono a vicenda.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false

# Resend, alternativa a SMTP. Usato solo se MAIL_PROVIDER=resend.
RESEND_API_KEY=
RESEND_SENDER_NAME=Common Era

# ─── Pagamenti (Stripe) ───────────────────────────────────────────────────────
# Vuote: il checkout resta simulato, nessun addebito reale, e l'applicazione
# parte lo stesso. Chiavi di test su https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Firma del webhook. In locale la stampa `stripe listen --forward-to \
# localhost:3000/api/payments/webhook`. Senza, il webhook rifiuta tutto.
STRIPE_WEBHOOK_SECRET=
