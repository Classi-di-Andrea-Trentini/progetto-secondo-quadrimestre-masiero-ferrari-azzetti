# Variabili in piu' richieste da docker-compose.prod.yml.
#
# NON sostituisce .env.example: sono le variabili dell'*infrastruttura* di
# produzione, e vanno aggiunte in coda allo stesso file `.env` gia' descritto li'
# (JWT_SECRET, DB_PASSWORD, SMTP, Stripe...). Compose legge un solo `.env`.
#
# Qui dentro, come in .env.example, non c'e' e non deve finire nessun valore vero.

# ─── Dominio ────────────────────────────────────────────────────────────────────
# Il nome sotto cui il sito e' pubblico. Finisce in tre posti che devono restare
# d'accordo fra loro: il `server_name` di nginx, il nome sul certificato TLS, e
# FRONTEND_URL/BACKEND_URL del backend (origine CORS ammessa e link nelle email).
#
# Per le prove in locale si lascia `localhost`: e' il nome per cui
# scripts/gen-self-signed-cert.sh emette il certificato quando lo si lancia senza
# argomenti.
SERVER_NAME=localhost

# ─── TLS ────────────────────────────────────────────────────────────────────────
# Dove nginx trova certificato e chiave, *dentro il container*.
#
# Come sono adesso: il certificato autofirmato prodotto da
#   ./scripts/gen-self-signed-cert.sh
# che serve a provare tutta la catena senza possedere un dominio. Il browser
# mostra un avviso — e' giusto cosi', non e' firmato da nessuno.
#
# Con Let's Encrypt attivo (vedi il servizio `certbot` in docker-compose.prod.yml)
# diventano, con il dominio vero al posto di <dominio>:
#   SSL_CERTIFICATE=/etc/letsencrypt/live/<dominio>/fullchain.pem
#   SSL_CERTIFICATE_KEY=/etc/letsencrypt/live/<dominio>/privkey.pem
SSL_CERTIFICATE=/etc/nginx/certs/fullchain.pem
SSL_CERTIFICATE_KEY=/etc/nginx/certs/privkey.pem

# Indirizzo a cui Let's Encrypt scrive quando un certificato sta per scadere e il
# rinnovo automatico non ha funzionato. Serve solo al primo rilascio con certbot.
# Va letto da qualcuno: e' l'ultimo avviso prima che il sito diventi
# irraggiungibile per certificato scaduto.
LETSENCRYPT_EMAIL=

# ─── Porte pubbliche ────────────────────────────────────────────────────────────
# Da cambiare solo se sulla macchina c'e' gia' qualcosa sulla 80 o sulla 443.
# La verifica di Let's Encrypt in modalita' webroot arriva sulla 80 e non si puo'
# spostare: con un valore diverso serve qualcosa davanti che rimetta le cose a
# posto, altrimenti il certificato non si rinnova.
HTTP_PORT=80
HTTPS_PORT=443

# ─── Nota su TRUST_PROXY ────────────────────────────────────────────────────────
# In .env.example c'e' `TRUST_PROXY`, che e' il numero di proxy di cui fidarsi in
# Express: lo legge il backend Node (server/), non quello Java. Il backend Java in
# produzione usa `SERVER_FORWARD_HEADERS_STRATEGY`, impostato direttamente in
# docker-compose.prod.yml perche' non ha valori da scegliere: dietro a questo
# nginx e' sempre `framework`. Non va messo qui.
